{
  "name": "yardmaster",
  "version": "0.2.0",
  "private": true,
  "description": "One CLI that routes any prompt to Claude, Codex, Cursor, or Gemini, with JSON output and real exit codes.",
  "license": "MIT",
  "author": "Dallas Crilley",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dallascrilley/yardmaster.git"
  },
  "bugs": {
    "url": "https://github.com/dallascrilley/yardmaster/issues"
  },
  "homepage": "https://github.com/dallascrilley/yardmaster#readme",
  "keywords": [
    "cli",
    "agent-client-protocol",
    "acp",
    "claude",
    "codex",
    "gemini",
    "cursor",
    "typescript"
  ],
  "bin": {
    "yardmaster": "./dist/bin/yardmaster.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:critical-path": "vitest run test/cli.help.integration.test.ts test/cli.exit-codes.integration.test.ts test/cli.review-json.integration.test.ts test/cli.linked-binary.integration.test.ts",
    "test:smoke": "vitest run --config vitest.smoke.config.ts",
    "test:smoke:preflight": "YARDMASTER_SMOKE_PROVIDERS=codex vitest run --config vitest.smoke.config.ts",
    "test:smoke:gemini": "YARDMASTER_SMOKE_PROVIDERS=gemini vitest run --config vitest.smoke.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate": "bun run typecheck && bun run test && bun run build && bun run test:critical-path",
    "doctor:flake": "bun run scripts/quantify-doctor-flake.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.17.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
