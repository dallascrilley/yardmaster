    "doctor:flake": "bun run scripts/quantify-doctor-flake.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.17.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
